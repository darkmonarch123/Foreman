# Foreman environment variables.
#
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit real values. `.env*` files are ignored by git, except this one.
#
# Every value here is a placeholder.

# ---------------------------------------------------------------------------
# Public (safe to expose to the browser)
# ---------------------------------------------------------------------------
# These are inlined into the JavaScript bundle at BUILD time, so on Render they
# must be set before the build runs, not only at runtime.

# Supabase project URL: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key: Project Settings -> API.
# This key is designed to be public. Row Level Security is what protects data.
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alternative name.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The exact public origin of this deployment, no trailing slash.
# Used to build the links in sign-up and password-reset emails.
# Local: http://localhost:3000   Render: https://your-service.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only (never prefix with NEXT_PUBLIC_, never expose to the browser)
# ---------------------------------------------------------------------------

# Foreman Assistant (rule-based, no external provider). Server-only feature flag.
# Off here and in production. Set "true" locally to try it, after running the
# assistant migration. If the variable is unset it is on in development and
# tests and OFF in production.
ASSISTANT_ENABLED=false

# NOT USED by the application today. Every database call runs as the signed-in
# user under Row Level Security, so the service-role key is not needed and
# should not be set on Render. It is listed only because the account-purge
# runbook in docs/security.md uses it from an operator's machine.
# SUPABASE_SERVICE_ROLE_KEY=

# Not used: avatars are generated locally by /api/avatar, so no third-party
# avatar provider receives anything.
# AVATAR_PROVIDER_URL=

# Not used yet: transactional email for invitations is deferred. Supabase Auth
# sends verification and password-reset email using the SMTP settings in the
# Supabase dashboard.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# End-to-end tests against a real Supabase project (optional; see docs/testing.md)
# ---------------------------------------------------------------------------
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=
# E2E_COLLABORATOR_EMAIL=
# E2E_COLLABORATOR_PASSWORD=
